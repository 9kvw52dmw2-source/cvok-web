<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CVOK</title>
    <!-- Ikony z FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Základní styly */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
        }

        /* Navigace - výchozí stav (Černé pozadí / Bílý text) */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #222222;
            z-index: 1000;
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        nav {
            max-width: 900px;
            margin: 0 auto;
            padding: 18px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-weight: 900;
            font-size: 1.4rem;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: 2px;
            transition: color 0.3s ease;
        }

        .nav-links {
            display: flex;
            gap: 24px;
            list-style: none;
        }

        .nav-links a {
            color: #888888;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .nav-links a:hover {
            color: #ffffff;
        }

        /* Navigace při skrolování nad černým pozadím - Bílý header / Černý text */
        header.scrolled-dark {
            background: rgba(255, 255, 255, 0.95);
            border-bottom: 1px solid #e5e5e5;
        }

        header.scrolled-dark .logo {
            color: #000000;
        }

        header.scrolled-dark .nav-links a {
            color: #555555;
        }

        header.scrolled-dark .nav-links a:hover {
            color: #000000;
        }

        /* Sekce O mně - Bílé pozadí / Černý text - na celou výšku */
        #omne {
            background-color: #ffffff;
            color: #000000;
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 80px;
            padding-bottom: 80px;
        }

        .about-wrapper {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 24px;
            width: 100%;
        }

        .about-container {
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 40px;
            align-items: center;
        }

        .about-text h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #000000;
            line-height: 1.3;
        }

        /* Obří nápis CVOK */
        .about-text h1 .cvok-title {
            display: block;
            font-size: 4.8rem;
            font-weight: 900;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            text-align-last: justify;
            margin-top: 5px;
            color: #000000;
        }

        .about-text p {
            color: #444444;
            font-size: 1.05rem;
            margin-top: 10px;
        }

        /* Čtvercové rozplynutí fotky po obvodu 1:1 */
        .profile-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .profile-img {
            width: 280px;
            height: 280px;
            object-fit: cover;
            -webkit-mask-image: 
                linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%),
                linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
            -webkit-mask-composite: source-in;
            mask-image: 
                linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%),
                linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
            mask-composite: intersect;
            margin-bottom: 4px;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            max-width: 240px;
            color: #000000;
            background: #f0f0f0;
            border: 1px solid #dddddd;
            padding: 10px 20px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .social-link:hover {
            background: #000000;
            color: #ffffff;
            border-color: #000000;
            transform: translateY(-2px);
        }

        /* Černý blok pro Galerie a Kontakt */
        .dark-block {
            background-color: #000000;
            color: #ffffff;
        }

        .dark-block section {
            max-width: 900px;
            margin: 0 auto;
            padding: 80px 24px;
        }

        .section-title {
            font-size: 1.8rem;
            margin-bottom: 40px;
            color: #ffffff;
            border-bottom: 1px solid #222222;
            padding-bottom: 10px;
            letter-spacing: 1px;
        }

        /* Sekce Galerie */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .gallery-item {
            background: #111111;
            border: 1px solid #222222;
            border-radius: 8px;
            overflow: hidden;
            aspect-ratio: 4 / 3;
            position: relative;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(30%);
            transition: transform 0.3s, filter 0.3s;
        }

        .gallery-item:hover img {
            transform: scale(1.05);
            filter: grayscale(0%);
        }

        /* Dvousloupcová sekce Kontakt */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: start;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding-top: 10px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 16px;
            color: #ffffff;
            font-size: 1.05rem;
        }

        .contact-item i {
            font-size: 1.2rem;
            color: #ffffff;
            width: 24px;
            text-align: center;
        }

        .contact-item a {
            color: #ffffff;
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .contact-item a:hover {
            opacity: 0.7;
            text-decoration: underline;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        input, textarea {
            background: #0a0a0a;
            border: 1px solid #222222;
            padding: 14px 18px;
            border-radius: 6px;
            color: #ffffff;
            font-family: inherit;
            font-size: 1rem;
            transition: border-color 0.2s;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: #ffffff;
        }

        button {
            background: #ffffff;
            color: #000000;
            border: none;
            padding: 14px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

        button:hover {
            background: #cccccc;
        }

        button:active {
            transform: scale(0.98);
        }

        footer {
            text-align: center;
            padding: 40px 24px;
            color: #444444;
            font-size: 0.85rem;
            border-top: 1px solid #111111;
            background-color: #000000;
        }

        /* Responzivita pro mobily */
        @media (max-width: 768px) {
            nav {
                padding: 14px 18px;
            }

            .nav-links {
                gap: 16px;
            }

            .about-container {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 30px;
            }

            .profile-wrapper {
                order: -1;
            }

            .profile-img {
                width: 240px;
                height: 240px;
            }

            .about-text h1 {
                font-size: 1.5rem;
                text-align: center;
            }
            
            .about-text h1 .cvok-title {
                font-size: 3.2rem;
                text-align: center;
                text-align-last: center;
                letter-spacing: 0.08em;
            }

            .about-text p {
                text-align: center;
            }

            .section-title {
                text-align: center;
            }

            .contact-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .contact-info {
                align-items: center;
            }

            .contact-item {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- Navigace -->
    <header id="main-header">
        <nav>
            <a href="#" class="logo">CVOK</a>
            <ul class="nav-links">
                <li><a href="#omne">O mně</a></li>
                <li><a href="#galerie">Galerie</a></li>
                <li><a href="#kontakt">Kontakt</a></li>
            </ul>
        </nav>
    </header>

    <!-- Sekce O mně (Bílá s černým písmem) -->
    <section id="omne">
        <div class="about-wrapper">
            <div class="about-container">
                <div class="about-text">
                    <h1>
                        Jmenuju se Dom a jsem tak trochu
                        <span class="cvok-title">CVOK</span>
                    </h1>
                    <p>Tady bude moje promluva o mně, kterou si sem později doplním...</p>
                </div>
                
                <div class="profile-wrapper">
                    <img src="profilovka.jpg" alt="Dom" class="profile-img">
                    <a href="https://instagram.com/dmnkcvok" target="_blank" class="social-link">
                        <i class="fa-brands fa-instagram"></i> @dmnkcvok
                    </a>
                    <a href="https://youtube.com/@dmnkcvok?si=NGbURvOyRhjeUnP8" target="_blank" class="social-link">
                        <i class="fa-brands fa-youtube"></i> @dmnkcvok
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Černý blok pro Galerie a Kontakt -->
    <div class="dark-block" id="dark-block">
        
        <!-- Sekce Galerie -->
        <section id="galerie">
            <h2 class="section-title">Galerie</h2>
            <div class="gallery-grid">
                <div class="gallery-item"><img src="https://via.placeholder.com/600x450" alt="Fotka 1"></div>
                <div class="gallery-item"><img src="https://via.placeholder.com/600x450" alt="Fotka 2"></div>
                <div class="gallery-item"><img src="https://via.placeholder.com/600x450" alt="Fotka 3"></div>
            </div>
        </section>

        <!-- Sekce Kontakt -->
        <section id="kontakt">
            <h2 class="section-title">Kontakt</h2>
            <div class="contact-grid">
                
                <!-- Levý sloupec s kontaktními údaji -->
                <div class="contact-info">
                    <div class="contact-item">
                        <i class="fa-solid fa-envelope"></i>
                        <a href="mailto:dmnk@cvok.eu">dmnk@cvok.eu</a>
                    </div>
                    <div class="contact-item">
                        <i class="fa-solid fa-phone"></i>
                        <span>+420 ___ ___ ___</span>
                    </div>
                    <div class="contact-item">
                        <i class="fa-brands fa-instagram"></i>
                        <a href="https://instagram.com/dmnkcvok" target="_blank">@dmnkcvok</a>
                    </div>
                    <div class="contact-item">
                        <i class="fa-solid fa-location-dot"></i>
                        <span>Česko</span>
                    </div>
                </div>

                <!-- Pravý sloupec s formulářem -->
                <form action="odeslat.php" method="POST">
                    <input type="text" name="name" placeholder="Tvoje jméno" required>
                    <input type="email" name="email" placeholder="Tvůj e-mail" required>
                    <textarea name="message" rows="5" placeholder="Tvoje zpráva..." required></textarea>
                    <button type="submit">Odeslat zprávu</button>
                </form>

            </div>
        </section>

        <footer>
            © 2026 CVOK
        </footer>

    </div>

    <!-- Skript pro změnu barvy lišty při skrolování na černou sekci -->
    <script>
        const header = document.getElementById('main-header');
        const darkBlock = document.getElementById('dark-block');

        const observerOptions = {
            root: null,
            threshold: 0.5 // Změna nastane v momentě, kdy černý blok zabere 50 % obrazovky
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    header.classList.add('scrolled-dark');
                } else {
                    header.classList.remove('scrolled-dark');
                }
            });
        }, observerOptions);

        observer.observe(darkBlock);
    </script>
</body>
</html>
